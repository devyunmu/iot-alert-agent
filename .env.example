# Runtime configuration. Copy the exports you need into your shell.
# Never commit real credentials.

# Loopback by default: the API has no authentication.
# Use ADDR="0.0.0.0:8080" only if you deliberately want LAN access.
export ADDR="127.0.0.1:8080"
export LLM_BASE_URL="http://127.0.0.1:3000/v1"
export LLM_API_KEY="sk-replace-me"
export LLM_MODEL="glm-5.3-flash"
export LLM_MAX_TOKENS="4000"
export LLM_TIMEOUT="180s"
export LLM_TEMPERATURE="0.2"
# export LLM_MOCK="1"   # force the deterministic rule-based analyzer